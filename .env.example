# ── Azure Storage (used by loading pipeline + DVC remote) ───────────────────
USER_PRINCIPAL_NAME=your_azure_user@yourdomain.onmicrosoft.com
PASSWORD=your_azure_password
REGION=eastasia
STORAGE_ACCOUNT_NAME=your_storage_account
CONTAINER_NAME=your_container
V2_CONTAINER_NAME=your_v2_container
TENANT_ID=your_tenant_id
CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# DB_PASSWORD is used by docker-compose to set up the postgres container
# DATABASE_URL is overridden inside docker-compose to point to the postgres service
# For local dev (no docker): set DATABASE_URL to your local postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/YuGen
OWNER=postgres

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1800
COLD_START_MIN_RATINGS=5

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_EXPT_NAME="yugen_test"

# ── AI / Chatbot ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key

# ── Redis ────────────────────────────────────────────────────────────────────
# docker-compose: use REDIS_HOST=redis (service name)
# local dev:      use REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
